{
    alternate_scroll = "off";
    blinking = "off";
    copy_on_select = false;
    dock = "bottom";
    detech_venv = {
        on = {
            directories = [".env" "env" ".venv" "venv"];
            activate_script = "default";
        };
    };
    env = {
        TERM = "alacritty";
    };

    font_family = "Mononoki Nerd Font Mono";
    working_director = "current_working_directory";
}
